{
  "name": "aios-auto-editor-v1",
  "version": "0.1.0",
  "private": true,
  "description": "AIOS desktop batch affiliate video editor for Windows",
  "author": "AIOS",
  "homepage": "https://github.com/itsneiq/AIOS",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "check": "node --check server.js && node --check renderer.js && node --check electron/main.js && node --check electron/preload.js",
    "dist": "electron-builder --win nsis",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aios.autoeditor",
    "productName": "AIOS Auto Editor",
    "artifactName": "AIOS-Auto-Editor-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 AIOS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "data/**/*",
      "templates/**/*",
      "server.js",
      "renderer.js",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "itsneiq",
        "repo": "AIOS",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "publisherName": "AIOS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIOS Auto Editor",
      "uninstallDisplayName": "AIOS Auto Editor"
    }
  }
}
